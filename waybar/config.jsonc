{
    "layer": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-right": ["battery", "clock"],
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
	"format": "{:%I:%M %p}",
        "format-alt": "{:%a %b %d   %I:%M %p}"
    }
}
