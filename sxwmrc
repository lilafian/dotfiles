gaps : 0
border_width : 0
master_width : 60

bind : mod + Return : "st"
bind : mod + d : "dmenu_run -fn 'Terminus-14' -nb '#000' -nf '#fff' -sb '#ddd' -sf '#000'"
call : mod + shift + q : close_window
call : mod + shift + e : quit
call : mod + l : master_increase
call : mod + h : master_decrease
call : mod + Up : master_next
call : mod + Down : master_prev
call : mod + Left : focus_prev
call : mod + Right: focus_next

